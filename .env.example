# ============================================================
# Environment Variables for Lav Crochets
# ============================================================
# Copy this file to .env and fill in the values

# Database (SQLite - local development)
DATABASE_URL="file:./dev.db"

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here-generate-with-openssl"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend) - https://resend.com
# For magic link authentication
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Lav Crochets <hello@lav-crochets.art>"

# Razorpay - https://dashboard.razorpay.com (use rzp_test_ keys locally)
# Key id is public (same value in both); the secret stays server-side only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Webhook secret you choose in Dashboard > Settings > Webhooks for
# https://<your-site>/api/razorpay/webhook (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Instagram (latest 5 posts on the homepage)
# Long-lived token from the Instagram API with Instagram Login, for the shop's
# professional account (Meta for Developers > your app > Instagram > API setup).
# Tokens last 60 days; refresh with GET https://graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token&access_token=TOKEN
INSTAGRAM_ACCESS_TOKEN=""

# Error reporting (optional): POST JSON for server + browser errors to this URL
# (e.g. a Slack/Discord incoming webhook). Errors are always logged as JSON lines.
ERROR_WEBHOOK_URL=""

# India Post live status on /track (optional, unofficial, may break): set to 1 to enable
INDIA_POST_LIVE_TRACKING=""
