  "orders-recover": {
    "label": "Recover a receipt",
    "path": "/orders/recover",
    "src": "orders-recover.html",
    "states": {
      "header-flat": true,
      "header-scrolled": "n/a",
      "default": true,
      "loading": {
        "kind": "submit-pending",
        "message": "After submit: button replaces label with a skeleton spinner dot; form is disabled."
      },
      "empty": false,
      "error": {
        "kind": "invalid-email",
        "message": "Client-side: invalid email pattern shows inline error below the field."
      },
      "success": {
        "kind": "anti-enum",
        "message": "Anti-enumeration response: regardless of match, show \"If we have any orders for that address, you will get a link within a minute.\""
      }
    }
  },
  "account-library": {
    "label": "Library",
    "path": "/account/library",
