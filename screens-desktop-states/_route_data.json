{
  "500": {
    "label": "500 Server error",
    "path": "/500",
    "src": "not-found.html",
    "states": {
      "header-flat": true,
      "header-scrolled": "n/a",
      "default": {
        "kind": "500-mock",
        "message": "Big H1, error reference code in mono, three CTAs (Try again, Back to home, Contact support)."
      },
      "loading": false,
      "empty": false,
      "error": "route-is-error",
      "success": false
    }
  },
  "index": {
    "label": "Home",
    "path": "/",
    "src": "index.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "hero+grid",
        "note": "Hero block reserves height via clamp(); featured grid renders skeleton cards while data fetches."
      },
      "empty": false,
      "error": {
        "kind": "page-error",
        "message": "If `/api/products?featured=true` errors, the FeaturedRow falls back to a \"Could not load this week's shelf. Try again.\" inline panel that preserves the row's height to avoid CLS."
      },
      "success": false
    }
  },
  "shop": {
    "label": "All printables",
    "path": "/shop",
    "src": "shop.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "shop-grid"
      },
      "empty": {
        "kind": "no-products",
        "message": "When zero products match the active filters: \"No printables match those filters.\" plus a Clear all CTA."
      },
      "error": {
        "kind": "page-error",
        "message": "If the shop query errors: \"Could not load printables.\" plus a Retry CTA. Filter sidebar still renders so the user can adjust."
      },
      "success": false
    }
  },
  "shop-category": {
    "label": "Category",
    "path": "/shop/[category]",
    "src": "shop.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "shop-grid"
      },
      "empty": {
        "kind": "no-products",
        "message": "Category exists but has zero published products. Show the empty grid with a \"Coming soon\" panel."
      },
      "error": {
        "kind": "page-error"
      },
      "success": false
    }
  },
  "product-detail": {
    "label": "Product detail",
    "path": "/products/[slug]",
    "src": "shop.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "product-detail"
      },
      "empty": false,
      "error": {
        "kind": "404-product",
        "message": "Slug not found: redirect to /not-found. Slug found but PDF generation failed: in-page banner offering Re-issue and Contact support."
      },
      "success": {
        "kind": "added-to-cart",
        "message": "After Add to cart: toast slides in bottom-right, cart icon count bumps with badgePop, sticky CTA briefly flashes the brand glow."
      }
    }
  },
  "cart": {
    "label": "Cart",
    "path": "/cart",
    "src": "cart.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "cart-lines"
      },
      "empty": {
        "kind": "empty-cart",
        "message": "Zero line items: centered illustration + \"Your cart is empty.\" + \"Browse all printables\" CTA."
      },
      "error": {
        "kind": "price-changed",
        "message": "Server returns 409 PRICE_CHANGED: warn-variant banner pushes to the top of the line list and auto-scrolls into view."
      },
      "success": false
    }
  },
  "thank-you-pending": {
    "label": "Thank you · Pending",
    "path": "/orders/thank-you-pending",
    "src": "thank-you-pending.html",
    "states": {
      "header-flat": true,
      "header-scrolled": "n/a",
      "default": true,
      "loading": {
        "kind": "pending-poll",
        "message": "The route IS the loading state for the order; polling indicator pulses below the headline."
      },
      "empty": false,
      "error": {
        "kind": "timeout",
        "message": "After 90s of polling without confirmation: switch to the \"we will email you when this confirms\" branch with a sticky retry banner."
      },
      "success": {
        "kind": "paid-redirect",
        "message": "When polling confirms: redirect to /orders/thank-you/[id] with the paid variant."
      }
    }
  },
  "thank-you-paid": {
    "label": "Thank you · Paid",
    "path": "/orders/thank-you/[id]",
    "src": "thank-you-paid.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": {
        "kind": "downloads"
      },
      "empty": false,
      "error": {
        "kind": "download-412",
        "message": "If a download link 412s mid-session (order refunded between page-load and tap): inline error inside the download row pointing to /account/library for live status."
      },
      "success": {
        "kind": "downloaded",
        "message": "After Download tap: button label switches to \"Downloaded\" with a check; no toast (the file landing is its own confirmation)."
      }
    }
  },
  "thank-you-failed": {
    "label": "Thank you · Failed",
    "path": "/orders/thank-you/[id] · failed",
    "src": "thank-you-failed.html",
    "states": {
      "header-flat": true,
      "header-scrolled": true,
      "default": true,
      "loading": false,
      "empty": false,
      "error": {
        "kind": "route-is-error",
        "message": "The route IS the error state. Sub-error: if the cart-intact lookup fails, hide the cart-still-has section and surface contact support."
      },
      "success": false
    }
  },
  "thank-you-refunded": {
    "label": "Thank you · Refunded",
    "path": "/orders/thank-you/[id] · refunded",
